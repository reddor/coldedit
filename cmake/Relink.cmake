# LGPL static-link distribution material. These files are never loaded by the app.
install(FILES ${CMAKE_CURRENT_LIST_DIR}/relink-CMakeLists.txt DESTINATION relink RENAME CMakeLists.txt)
install(FILES ${CMAKE_CURRENT_LIST_DIR}/Lame.cmake ${CMAKE_CURRENT_LIST_DIR}/lame-config.h.in DESTINATION relink)
install(FILES ${CMAKE_CURRENT_LIST_DIR}/RELINKING.txt DESTINATION relink RENAME README.txt)
install(DIRECTORY ${lame_SOURCE_DIR}/ DESTINATION relink/lame)
foreach(pair coldedit_core coldedit_audio coldedit_imgui FLAC)
  install(FILES $<TARGET_FILE:${pair}> DESTINATION relink/lib RENAME ${pair}${CMAKE_STATIC_LIBRARY_SUFFIX})
endforeach()
if(EMSCRIPTEN)
  set(relink_objects main_web.cpp editor.cpp platform.cpp)
  set(relink_extension o)
  install(FILES ${imgui_SOURCE_DIR}/misc/fonts/Roboto-Medium.ttf ${imgui_SOURCE_DIR}/misc/fonts/Cousine-Regular.ttf DESTINATION relink/fonts)
else()
  set(relink_objects main.cpp editor.cpp platform.cpp)
  if(MSVC)
    set(relink_extension obj)
  else()
    set(relink_extension o)
  endif()
  install(FILES $<TARGET_FILE:glfw> DESTINATION relink/lib RENAME glfw${CMAKE_STATIC_LIBRARY_SUFFIX})
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/relink-toolchain.txt"
  "System: ${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}\nC compiler: ${CMAKE_C_COMPILER_ID} ${CMAKE_C_COMPILER_VERSION}\nC++ compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\nCMake: ${CMAKE_VERSION}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/relink-toolchain.txt" DESTINATION relink RENAME TOOLCHAIN.txt)
foreach(source IN LISTS relink_objects)
  install(FILES ${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/coldedit.dir/src/${source}.${relink_extension} DESTINATION relink/objects)
endforeach()
